# Kopieer naar .env (staat in .gitignore). Geheimen nooit in de repo.
# Poort op de server
APP_PORT=3400
# Wachtwoord van de PostgreSQL-container (verplicht)
POSTGRES_PASSWORD=
# Hoofdsleutel voor versleutelde aanmeldgegevens (64 hex-tekens, `openssl rand -hex 32`).
# Leeg = wordt eenmalig aangemaakt in /data/master-key. Bewaar hem apart van de database-back-up.
AVANTA_MASTER_KEY=
# Pas op true zetten bij go-live: dan mogen zoekmachines indexeren.
SITE_INDEXABLE=false
# Openbaar basisadres van de site voor canonical-URL's, sitemap en robots.txt (zonder slash aan het eind).
SITE_URL=https://www.avantareizen.nl
# Exact adres van de reverse proxy voor het bezoekersadres (limiet per bezoeker). Leeg laten zonder proxy (= loopback).
TRUST_PROXY=
