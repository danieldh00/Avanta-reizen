{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "timezone": "Europe/Amsterdam",
  "schedule": [
    "before 9am on monday"
  ],
  "dependencyDashboard": true,
  "automerge": false,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "rebaseWhen": "conflicted",
  "labels": [
    "dependencies",
    "geen-releasenotes"
  ],
  "packageRules": [
    {
      "description": "Minor en patch van alle managers in één groep-PR per week",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "minor en patch",
      "groupSlug": "minor-patch"
    },
    {
      "description": "Majors krijgen elk een eigen PR (standaard), niet automatisch samenvoegen",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "description": "Images met digest in workflows en scripts (docker run, env-variabelen) die Renovate anders niet ziet",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/",
        "/^deploy/.+\\.sh$/"
      ],
      "matchStrings": [
        "(?<depName>(?:[a-z0-9.-]+/)?[a-z0-9._/-]+):(?<currentValue>[A-Za-z0-9._-]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
