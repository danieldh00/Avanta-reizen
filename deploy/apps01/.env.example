# Kopieer naar .env (chmod 600). Geheimen nooit in git. install.sh vult dit bij de eerste keer zelf in.
# Docker-netwerk van de bestaande cloudflared op apps01 (docker inspect <container>); leeg = install.sh zoekt het.
TUNNEL_NETWORK=
# Wachtwoord van de beheerder `avanta` (superuser, alleen voor onderhoud): openssl rand -hex 24
POSTGRES_PASSWORD=
# Wachtwoord van de databaserol avanta_app waarmee de app verbindt (geen superuser): openssl rand -hex 24.
# install.sh maakt het zelf aan als het ontbreekt.
APP_DB_PASSWORD=
# Hoofdsleutel voor versleutelde aanmeldgegevens: openssl rand -hex 32. Bewaar hem apart van de database-back-up.
AVANTA_MASTER_KEY=
# Vorige hoofdsleutels na een rotatie (servertaken.sh sleutel-roteren zet ze hier), kommagescheiden; leeg = geen.
AVANTA_MASTER_KEY_PREVIOUS=
# Testomgeving: eigen adres voor canonicals/sitemap en altijd noindex. Productie blijft www.avantareizen.nl.
SITE_URL=https://avanta.den-hollander.com
SITE_INDEXABLE=false
# Exact IP-adres van de cloudflared-container in het tunnelnetwerk; install.sh zet het bij elke run opnieuw.
TRUST_PROXY=
# Poort op apps01, alleen lokaal (voor een curl-test op de server).
APP_BIND=127.0.0.1
APP_PORT=3400
# Branch die avanta-update.timer volgt (elke 15 minuten; nieuwe commit = bijwerken met rollback bij een mislukte healthcheck).
AVANTA_TRACK=main
# Map met de status- en aanvraagmap voor updaten vanuit de app (install.sh zet hem, standaard /opt/apps/avanta/update).
UPDATE_DIR=/opt/apps/avanta/update
# Naam van de bestaande cloudflared-container; leeg = install.sh zoekt de enige container waarvan de naam op
# "cloudflared" eindigt en zet hem hier neer.
TUNNEL_CONTAINER=
# Later, als het GHCR-image bestaat: AVANTA_IMAGE=ghcr.io/danieldh00/avanta-reizen:<versie>
# AVANTA_IMAGE=
