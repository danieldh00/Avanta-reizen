# Kopieer naar .env (chmod 600). Geheimen nooit in git.
# Start ook de cloudflared-container uit deze stack. Leeg laten als een bestaande cloudflared elders doorstuurt.
COMPOSE_PROFILES=tunnel
# Token van de tunnel: Cloudflare-dashboard > Networks > Tunnels > <tunnel> > Install connector (de lange eyJ…-string).
TUNNEL_TOKEN=
# Database-wachtwoord: openssl rand -hex 24
POSTGRES_PASSWORD=
# Hoofdsleutel voor versleutelde aanmeldgegevens: openssl rand -hex 32. Bewaar hem apart van de database-back-up.
AVANTA_MASTER_KEY=
# Testomgeving: eigen adres voor canonicals/sitemap en altijd noindex. Productie blijft www.avantareizen.nl.
SITE_URL=https://avanta.den-hollander.com
SITE_INDEXABLE=false
# Vertrouwde proxy voor X-Forwarded-For/-Proto. uniquelocal = cloudflared in dit Docker-netwerk.
# Draait cloudflared op een andere host: zet hier het IP van die host (bijv. 192.168.1.20).
TRUST_PROXY=uniquelocal
# Poort op apps01; 127.0.0.1 = alleen lokaal bereikbaar. 0.0.0.0 alleen als cloudflared op een andere host draait.
APP_BIND=127.0.0.1
APP_PORT=3400
# Later, als het GHCR-image bestaat: AVANTA_IMAGE=ghcr.io/danieldh00/avanta-reizen:<versie>
# AVANTA_IMAGE=
