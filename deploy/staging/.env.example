# Kopieer naar .env (chmod 600). Geheimen nooit in git. install-staging.sh vult dit bij de eerste keer zelf in, met
# eigen geheimen: staging deelt geen sleutel, wachtwoord of database met de testomgeving.
# Wachtwoord van de beheerder `avanta` van de staging-database (superuser, alleen voor onderhoud).
POSTGRES_PASSWORD=
# Wachtwoord van de databaserol avanta_app waarmee de app verbindt (geen superuser).
APP_DB_PASSWORD=
# Eigen hoofdsleutel van staging (openssl rand -hex 32). Er staan alleen testgegevens in; geen kopie nodig.
AVANTA_MASTER_KEY=
# Adres van staging voor canonieke adressen; altijd noindex.
SITE_URL=https://avanta-staging.den-hollander.com
# Poort op de server, alleen lokaal (voor een curl-test).
APP_PORT=3401
# Netwerk en naam van de bestaande cloudflared-container en zijn exacte IP-adres; install-staging.sh neemt netwerk en
# naam over van de testomgeving en zet het IP-adres bij elke run opnieuw.
TUNNEL_NETWORK=
TUNNEL_CONTAINER=
TRUST_PROXY=
