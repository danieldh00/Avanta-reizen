{
  "name": "avanta-reizen",
  "version": "0.35.5",
  "private": true,
  "description": "Avanta Reizen: website en (later) CRM",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "PASSWORD_BREACH_CHECK=false node --test",
    "test:coverage": "PASSWORD_BREACH_CHECK=false node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-include='tools/**' --test-coverage-exclude='src/dev/**' --test-coverage-exclude='tools/design-check/**' --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=93",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "import": "node tools/import-wordpress.js"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "express": "^5.3.0",
    "node-html-parser": "^7.1.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.14.0",
    "typescript": "7.0.2"
  }
}
